{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "react", "unicorn", "oxc"],
    "jsPlugins": [
        {
            "name": "rules",
            "specifier": "./tools/oxlint/rules/index.ts"
        },
        {
            "name": "@stylistic",
            "specifier": "@stylistic/eslint-plugin"
        }
    ],
    "categories": {
        "correctness": "error",
        "suspicious": "off",
        "perf": "warn",
        "style": "off",
        "pedantic": "off",
        "restriction": "off",
        "nursery": "off"
    },
    "env": {
        "builtin": true,
        "browser": true,
        "es2022": true
    },
    "settings": {
        "react": {
            "version": "19.0.0",
            "linkComponents": [
                {
                    "name": "Link",
                    "linkAttribute": "to"
                },
                {
                    "name": "NavLink",
                    "linkAttribute": "to"
                }
            ]
        }
    },
    "options": {
        "reportUnusedDisableDirectives": "warn",
        "typeAware": true,
        "respectEslintDisableDirectives": true
    },
    "rules": {
        // React's act() is typed void for sync callbacks but returns an awaitable at runtime.
        "typescript/await-thenable": "off",
        // String(label) is only reached with string labels; SelectOption types label as ReactNode.
        "typescript/no-base-to-string": "off",
        // Only flags spreading ASCII strings, where code-point splitting is harmless.
        "typescript/no-misused-spread": "off",
        // Props typed with method syntax are plain functions, so every hit is a false positive.
        "typescript/unbound-method": "off"
    },
    "ignorePatterns": [
        "public/**",
        "resources/views/**",
        ".claude/**",
        "**/generated/*",
        "!resources/scripts/api/generated/types.gen.ts"
    ],
    "overrides": [
        {
            "files": ["**/*.{ts,tsx,js,jsx,mjs}"],
            "excludeFiles": ["**/generated/**"],
            "rules": {
                "rules/no-chained-type-assertions": "error",
                "rules/no-conditional-empty-object-spread": "error",
                "rules/no-known-value-widening": "error",
                "rules/no-object-parameters": "error",
                "rules/no-runtime-typeof": "error",
                "rules/no-shape-in-symbol-names": "error",
                "rules/no-unknown-parameters": "error",
                "rules/no-unknown-type-aliases": "error",
                "rules/no-unsafe-dictionary-type": "error",
                "rules/no-widen-then-assert": "error",
                "@stylistic/padding-line-between-statements": [
                    "error",
                    { "blankLine": "always", "prev": ["const", "let"], "next": "*" },
                    { "blankLine": "any", "prev": ["const", "let"], "next": ["const", "let"] },
                    { "blankLine": "always", "prev": "block-like", "next": "*" },
                    { "blankLine": "always", "prev": "*", "next": "return" }
                ],
                "arrow-body-style": ["error", "as-needed"],
                "complexity": ["error", { "max": 15 }],
                "curly": ["error", "all"],
                "eqeqeq": "error",
                "max-depth": ["error", { "max": 3 }],
                "max-nested-callbacks": ["error", { "max": 3 }],
                "no-implicit-coercion": ["error", { "allow": ["!!"] }],
                "no-nested-ternary": "error",
                "object-shorthand": "error",
                "prefer-arrow-callback": "error",
                "prefer-const": "error",
                "prefer-exponentiation-operator": "error",
                "prefer-template": "error",
                "no-use-before-define": "warn",
                "no-unused-expressions": [
                    "error",
                    {
                        "allowShortCircuit": true,
                        "allowTernary": true
                    }
                ],
                "no-unused-vars": [
                    "warn",
                    {
                        "argsIgnorePattern": "^_",
                        "varsIgnorePattern": "^_"
                    }
                ],
                "react/display-name": "off",
                "react/react-in-jsx-scope": "off",
                "react/rules-of-hooks": "error",
                "react/exhaustive-deps": "warn",
                "react/jsx-curly-brace-presence": "error",
                "react/jsx-fragments": "error",
                "react/jsx-no-useless-fragment": "error",
                "typescript/no-explicit-any": "error",
                "typescript/array-type": "error",
                "typescript/no-inferrable-types": "error",
                "typescript/prefer-nullish-coalescing": [
                    "error",
                    {
                        "ignorePrimitives": {
                            "bigint": true,
                            "boolean": true,
                            "number": true,
                            "string": true
                        }
                    }
                ],
                "typescript/prefer-optional-chain": "error",
                "typescript/switch-exhaustiveness-check": "error",
                "unicorn/no-array-for-each": "error",
                "unicorn/no-negated-condition": "error",
                "unicorn/no-useless-spread": "error",
                "unicorn/no-useless-undefined": ["error", { "checkArguments": false }],
                "unicorn/prefer-array-some": "error",
                "unicorn/prefer-at": "error",
                "unicorn/prefer-includes": "error",
                "unicorn/prefer-spread": "error",
                "unicorn/prefer-string-replace-all": "error",
                "typescript/no-non-null-assertion": "off",
                "typescript/consistent-type-imports": [
                    "error",
                    {
                        "fixStyle": "inline-type-imports"
                    }
                ],
                "typescript/ban-ts-comment": [
                    "error",
                    {
                        "ts-expect-error": "allow-with-description"
                    }
                ]
            }
        },
        {
            // describe → it → act → callback nesting is normal in tests.
            "files": ["**/*.spec.{ts,tsx}"],
            "rules": {
                "max-nested-callbacks": "off"
            }
        },
        {
            "files": ["resources/scripts/**"],
            "excludeFiles": ["resources/scripts/state/**", "**/generated/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["zustand", "zustand/*"],
                                "message": "Access state through resources/scripts/state."
                            },
                            {
                                "group": ["@/state/hooks", "@/api/useGeneratedMutation"],
                                "message": "Use the current state and generated API interfaces."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["resources/scripts/**"],
            "excludeFiles": ["**/generated/**"],
            "rules": {
                "rules/generated-api-imports": "error"
            }
        },
        {
            "files": ["resources/scripts/**", "packages/hello-world/src/client/**"],
            "excludeFiles": ["**/generated/**", "**/*.spec.{ts,tsx}"],
            "rules": {
                "rules/design-tokens": "error"
            }
        },
        {
            "files": ["resources/scripts/api/**", "packages/hello-world/src/client/**"],
            "excludeFiles": ["**/generated/**", "**/*.spec.{ts,tsx}"],
            "rules": {
                "rules/generated-api-mutations": "error",
                "no-restricted-properties": [
                    "error",
                    {
                        "object": "http",
                        "property": "get",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "http",
                        "property": "post",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "http",
                        "property": "put",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "http",
                        "property": "patch",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "http",
                        "property": "delete",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "http",
                        "property": "request",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "axios",
                        "property": "get",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "axios",
                        "property": "post",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "axios",
                        "property": "put",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "axios",
                        "property": "patch",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "axios",
                        "property": "delete",
                        "message": "Use the generated API client."
                    },
                    {
                        "object": "axios",
                        "property": "request",
                        "message": "Use the generated API client."
                    }
                ]
            }
        },
        {
            "files": [
                "resources/scripts/api/server/backups/queries.ts",
                "resources/scripts/api/server/files/queries.ts"
            ],
            "rules": {
                "rules/generated-api-mutations": "off"
            }
        },
        {
            "files": [
                "resources/scripts/api/http.ts",
                "resources/scripts/api/interceptors.ts",
                "resources/scripts/api/server/files/queries.ts"
            ],
            "rules": {
                "no-restricted-properties": "off"
            }
        },
        {
            "files": ["resources/scripts/api/generated/types.gen.ts"],
            "rules": {
                "rules/generated-api-types": "error",
                "typescript/no-duplicate-type-constituents": "off",
                "typescript/no-redundant-type-constituents": "off",
                "typescript/no-empty-object-type": "error"
            }
        },
        {
            // ESTree literals are discriminated only by the runtime type of `value`; this helper is that decoder.
            "files": ["tools/oxlint/rules/shared/literals.ts"],
            "rules": {
                "rules/no-runtime-typeof": "off"
            }
        }
    ]
}
