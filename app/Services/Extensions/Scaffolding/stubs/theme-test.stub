import { afterEach, beforeAll, expect, test } from 'vitest';
import { preloadTheme, renderPrimitive, renderView, type RenderedView } from '@pterodactyl/sdk/testing';
import theme from './theme';

let rendered: RenderedView | undefined;

// Loads the chunks of views declared with lazyView, so renderView renders them at once.
beforeAll(() => preloadTheme(theme));
afterEach(() => rendered?.unmount());

test('frames the classic app layout', () => {
    rendered = renderView('layout.app', { theme, fixture: 'admin' });

    expect(rendered.container.querySelector('[data-{{id}}-layout] main')).not.toBeNull();
});

test('draws buttons as pills', () => {
    rendered = renderPrimitive('Button', { children: 'Save' }, { theme });

    expect(rendered.container.querySelector('button')?.className).toContain('rounded-full');
});
