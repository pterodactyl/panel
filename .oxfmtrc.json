{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "endOfLine": "lf",
  "trailingComma": "es5",
  "sortPackageJson": false,
  "ignorePatterns": ["resources/scripts/api/generated/**"]
}
