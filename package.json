        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "codemirror": "^6.0.2",
        "dayjs": "^1.11.21",
        "ghostty-web": "^0.4.0",
        "i18next": "^25.8.0",
        "i18next-http-backend": "^3.0.2",
        "i18next-multiload-backend-adapter": "^2.3.0",
        "lucide-react": "^1.17.0",
        "pathe": "^2.0.3",
        "qrcode.react": "^4.2.0",
