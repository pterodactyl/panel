    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@oxlint/plugins": "^1.77.0",
        "@tailwindcss/postcss": "^4",
        "@testing-library/dom": "^10",
        "@testing-library/jest-dom": "^6",
        "@testing-library/react": "^16",
        "@testing-library/user-event": "^14.2.1",
        "@types/node": "^22.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react-swc": "^4",
        "jsdom": "^26.1.0",
        "oxfmt": "^0.58.0",
        "oxlint": "^1.77.0",
        "postcss": "^8.5.6",
        "typescript": "^6",
        "vite": "^8",
        "vitest": "^4.1.9"
    },
    "scripts": {
        "clean": "cd public/assets && find . \\( -name \"*.js\" -o -name \"*.map\" \\) -type f -delete",
        "test": "vitest run",
        "test:watch": "vitest",
        "tsc": "tsc --noEmit && tsc --project tools/oxlint/rules && npm --prefix packages/hello-world run typecheck",
        "lint": "oxfmt --check resources/scripts packages/hello-world tools/oxlint && oxlint resources/scripts packages/hello-world/src/client",
        "api:generate": "openapi-ts",
        "extension:api:generate": "node scripts/generate-extension-api.mjs",
        "api:refresh": "PTERODACTYL_EXTENSIONS_ENABLED=false composer docs:openapi:verify && npm run api:generate",
        "api:check": "npm run sdk:check && npm run tsc && npm run lint",
        "dev": "vite",
        "watch": "vite build --watch",
        "prebuild": "npm run sdk:generate",
        "build": "vite build",
        "postbuild": "node scripts/check-extension-runtime.mjs",
        "build:force": "npm run build --",
        "build:production": "npm run build --",
        "build:vite": "npm run build && npm --prefix packages/hello-world run build",
        "serve": "vite",
        "sdk:generate": "node scripts/generate-sdk-types.mjs && node scripts/generate-sdk-icons.mjs",
        "sdk:check": "node scripts/generate-sdk-types.mjs --check && node scripts/generate-sdk-icons.mjs --check && npm run sdk:testing && vitest run packages/sdk/types-drift.spec.ts",
        "sdk:testing": "node scripts/build-sdk-testing.mjs",
        "pretest": "npm run sdk:testing"
    },
    "browserslist": [
        "> 0.5%",
        "last 2 versions",
        "firefox esr",
        "not dead"
    ]
}
